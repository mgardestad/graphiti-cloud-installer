# =============================================================================
# Graphiti Cloud Installer - Environment Configuration Template
# =============================================================================
# Copy this file to .env and fill in your actual values
# Never commit the .env file to version control!

# =============================================================================
# LLM Provider API Keys
# =============================================================================
# At least one LLM provider API key is required for Graphiti to function
# Obtain keys from the respective provider portals:
# - OpenAI: https://platform.openai.com/api-keys
# - Anthropic: https://console.anthropic.com/settings/keys
# - Google (Gemini): https://makersuite.google.com/app/apikey
# - Groq: https://console.groq.com/keys

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
GROQ_API_KEY=

# =============================================================================
# Database Configuration - FalkorDB (Default, Lightweight)
# =============================================================================
# FalkorDB is the default graph database (Redis-based)
# Recommended for: Development, testing, small deployments (<100k nodes)
# Resource requirements: Low (512MB-1GB RAM)

FALKORDB_URI=redis://falkordb:6379

# =============================================================================
# Database Configuration - Neo4j (Production Alternative)
# =============================================================================
# Neo4j is recommended for production and large-scale deployments
# Recommended for: Production, large graphs (>100k nodes)
# Resource requirements: Higher (2GB+ RAM recommended)

NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=

# =============================================================================
# Database Selection
# =============================================================================
# Choose which database to use: "falkordb" or "neo4j"
# This determines which docker-compose file will be used

DATABASE_TYPE=falkordb

# =============================================================================
# Server Configuration
# =============================================================================
# SEMAPHORE_LIMIT: Maximum number of concurrent operations
# Adjust based on your instance resources (default: 10)

SEMAPHORE_LIMIT=10

# Telemetry: Set to "true" to enable anonymous usage statistics
# Set to "false" to disable telemetry (recommended for privacy)

GRAPHITI_TELEMETRY_ENABLED=false

# =============================================================================
# Domain and SSL Configuration
# =============================================================================
# Required for HTTPS setup with Let's Encrypt
# Leave empty if using IP address only (HTTP)

DOMAIN_NAME=

# =============================================================================
# Optional: Advanced Configuration
# =============================================================================
# Uncomment and configure if needed

# Custom port for MCP server (default: 8000)
# MCP_PORT=8000

# Custom log level (DEBUG, INFO, WARNING, ERROR)
# LOG_LEVEL=INFO

# Custom data directory for persistence
# DATA_DIR=/var/lib/graphiti
